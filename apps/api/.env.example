# App
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Database (Neon Serverless PostgreSQL)
# DATABASE_URL: Pooled connection string (used by app runtime)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.ap-south-1.aws.neon.tech/neha_institute?sslmode=require
# DIRECT_URL: Direct / unpooled connection string (required by Prisma migrations)
DIRECT_URL=postgresql://user:password@ep-sample.ap-south-1.aws.neon.tech/neha_institute?sslmode=require

# Initial Admin Seeding (required when running `npm run db:seed`)
# Refuses to run if NODE_ENV=production. No hardcoded default credentials.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_secure_password
ADMIN_NAME=Neha Ma'am

# JWT
JWT_SECRET=change_me_to_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=120m
REFRESH_TOKEN_SECRET=change_me_to_another_long_random_string_min_32_chars

# Google OAuth (GIS — ID token verification only)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# AWS S3 Storage (Recipe PDFs & resources)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_BUCKET_NAME=neha-institute-storage

# Bunny Stream Video (Phase 1+)
BUNNY_LIBRARY_ID=your_bunny_library_id
BUNNY_API_KEY=your_bunny_api_key
BUNNY_TOKEN_AUTH_KEY=your_bunny_token_auth_key
BUNNY_CDN_HOSTNAME=video.yourdomain.com
# Secret token appended to webhook URL (e.g. /api/webhooks/bunny?token=<SECRET_TOKEN>)
BUNNY_WEBHOOK_SECRET_TOKEN=your_random_bunny_webhook_secret_token
